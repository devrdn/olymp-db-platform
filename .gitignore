# Secrets — never commit real credentials
.env
*.env
!.env.example
!deploy/.env.example

# Go build output
backend/bin/
coverage.out
*.test

# Editors and OS
.DS_Store
.idea/
.vscode/

# Database dumps are data, never source: they hold real participant answers.
deploy/backups/
# Dumps uploaded to an API running on the host (make run).
deploy/game-uploads/
# Cover pictures uploaded to an API running on the host (make run).
deploy/covers/

# Working notes of an agent session: plans, reviews, fix lists. Each of these
# directories carries a .gitignore of its own, which only helps once the
# directory exists.
.superpowers/
