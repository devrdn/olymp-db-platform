# Secrets — never commit real credentials
.env
*.env
!.env.example
!deploy/.env.example

# Go build output
backend/bin/
coverage.out
*.test

# Editors and OS
.DS_Store
.idea/
.vscode/

# Database dumps are data, never source: they hold real participant answers.
deploy/backups/
# Dumps uploaded to an API running on the host (make run).
deploy/game-uploads/
# Cover pictures uploaded to an API running on the host (make run).
deploy/covers/

# Working notes of a planning session: specs, plans, reviews, fix lists, and
# the editor scratch beside them. They are the scaffolding a change was built
# with, not the change; what survives a feature is its commit messages, the
# prose under docs/, and the code.
.superpowers/
docs/superpowers/
.claude/
