# Copy to .env.local and adjust. Next reads .env.local automatically and it is
# git-ignored, so local settings never travel with a commit.
#
# Only variables the server reads belong here. Anything prefixed NEXT_PUBLIC_ is
# inlined into the browser bundle at build time and is therefore public and
# frozen into the image — this application has none, and adding one is a
# decision rather than a convenience.

# Where the Next server dials the Core API.
#
# The private address on the internal network, not the public one: a page
# request from the browser is same-origin through the reverse proxy and needs no
# origin at all. Required in production, where a missing value is a startup
# error rather than a guess.
API_ORIGIN=http://localhost:8080
