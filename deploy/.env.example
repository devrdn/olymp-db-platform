# Copy to deploy/.env and fill in real values. Both Compose and the Makefile
# read that exact path, so it has to live next to the compose files:
#
#   cp deploy/.env.example deploy/.env
#
# .env holds credentials and must never be committed.
# Generate secrets with: openssl rand -base64 32

# --- Core database -----------------------------------------------------------
CORE_DB_USER=dbcontest
CORE_DB_PASSWORD=change-me-before-first-run
CORE_DB_NAME=dbcontest_core
# Host port for the development overlay only; the stack itself talks over the
# private network.
CORE_DB_PORT=5432

# Adminer (dev database browser): make dev-db-ui, then http://localhost:8081.
ADMINER_PORT=8081

# --- Cache (optional) --------------------------------------------------------
# Leave REDIS_ADDR empty (the normal case) to run without a shared cache: the
# API falls back to its in-process store. That is correct for ONE replica and
# wrong for several — sessions and rate limits stop being shared. To use Redis
# instead, set REDIS_PASSWORD below and start the "shared" compose profile
# (`make dev-up` / `docker compose --profile shared up -d redis`) — both
# `docker-compose.yml` (for the containerized api) and the Makefile (for
# `make run` on the host) derive the right address from REDIS_PASSWORD on
# their own; leaving REDIS_ADDR empty here is what lets each side compute its
# own correct value.
#
# Only set REDIS_ADDR explicitly to point the CONTAINERIZED api at a Redis
# that isn't this compose stack's own `redis` service (an external cache, a
# different port). It has no effect on `make run` — a bare process on the
# host cannot resolve compose network hostnames like `redis` anyway, so the
# Makefile always computes its own host-relative address from
# REDIS_PASSWORD instead of reading this value. See the Makefile comment
# next to REDIS_ADDR for exactly why.
REDIS_ADDR=
REDIS_PASSWORD=change-me-before-first-run
REDIS_PORT=6379

# --- Ingress -----------------------------------------------------------------
# The hostname Caddy serves and obtains a certificate for. Left as "localhost"
# it issues a local certificate itself, so the stack is HTTPS with no setup;
# set a real hostname and it obtains a public certificate automatically.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- API ---------------------------------------------------------------------
# Only used by the development overlay, which exposes the API directly.
API_PORT=8080
ENV=production
LOG_LEVEL=info

# Where request statistics go: prometheus (scrape endpoint), log (periodic
# digest into the log stream) or none.
METRICS_BACKEND=prometheus

# --- Sessions ----------------------------------------------------------------
# Idle lifetime of a session; it slides on every authenticated request.
SESSION_TTL=12h

# CIDRs whose X-Forwarded-For is trusted when resolving client addresses.
# Defaults to the pinned compose network (Caddy). Add your LB's range if one
# sits in front; leave empty when clients connect directly.
TRUSTED_PROXIES=172.28.0.0/16

# Mark the session cookie Secure. Defaults to true outside ENV=development.
# Leave it on wherever the site is served over HTTPS: a browser will not send a
# Secure cookie over plain HTTP, and will not protect a non-Secure one.
COOKIE_SECURE=true

# --- Observability (optional) ------------------------------------------------
# Started with: docker compose --profile observability up -d
# Without it, set METRICS_BACKEND=log so request statistics reach the log
# stream instead of an endpoint nobody scrapes.
GRAFANA_PASSWORD=change-me-before-first-run
GRAFANA_PORT=3001

# --- First administrator -----------------------------------------------------
# Used by: docker compose --profile bootstrap run --rm bootstrap
ADMIN_LOGIN=admin
ADMIN_NAME=System Administrator

# Image tag and the version reported by /api/v1/version.
VERSION=dev
