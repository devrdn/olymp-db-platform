# The scheduled backup of DB Contest: `make backup`, rotation, and the
# optional off-host copy, run by deploy/backups/scheduled-backup.sh.
# Rendered and installed by `deploy/backups/schedule.sh install`, which fills
# in the checkout and the user; started by dbcontest-backup.timer.
[Unit]
Description=DB Contest backup (core dump, covers, game uploads) and rotation
Documentation=file://@ROOT@/backend/README.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The user must be able to run docker compose: the one who runs make deploy.
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/deploy/backups/scheduled-backup.sh
SyslogIdentifier=dbcontest-backup
UMask=0077
NoNewPrivileges=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# A hung run is a failure, not a silence: without a limit a stuck docker exec
# would hold the unit, and every later trigger with it, for good.
TimeoutStartSec=40min
